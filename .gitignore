# Session Google de l'utilisateur (cookies, adresse e-mail) : ne jamais publier
.profil_google/

# Environnement Python et fichiers temporaires
.venv/
__pycache__/
*.pyc

# Journaux (régénérés par l'application)
*.log
# Fichiers de travail de SQLite en mode WAL (le contenu est reporté dans vols.db)
vols.db-wal
vols.db-shm
# vols.db (prix collectés) est versionné : la version en ligne (Streamlit Cloud) n'a pas d'autre source de données

# Routines et réglages d'alerte (adresse e-mail personnelle) : propres à ce PC
routines.json
alerte_routine.json

# Donnée Airfox chargée dans l'application (propre à ce PC)
donnee_chargee/

# Actualisation en arrière-plan (avancement en cours) et historique des actualisations (propres à ce PC)
actualisation.json
actualisation.tmp
actualisation_paires.json
derniere_table.json
actualisation.arret
actualisation.log
historique_actualisations/
historique_tables/

# Rythme des recherches Google, ajusté automatiquement (propre à ce PC et à sa connexion)
rythme.json

# Couleurs des graphiques choisies dans Data Visualisation (préférence de ce PC)
couleurs_graphiques.json

# Version portable (python + bibliothèques + application, ~140 Mo) : se refait avec construire_portable.py
dist/
sauvegardes/
